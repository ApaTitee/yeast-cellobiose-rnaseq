# ---- 大文件：不入库，仅保留下载/构建脚本与校验值 ----
data/raw/fastq/*
!data/raw/fastq/.gitkeep
data/processed/fastq/*
!data/processed/fastq/.gitkeep
refs/index/
refs/host/*.fna.gz
refs/host/*.fa.gz
refs/host/*.gbff.gz
*.bam
*.bam.bai
*.bai
*.sra
*.fastq
*.fastq.gz

# ---- 中间校验产物（汇总值见 checksums/md5_verification.tsv）----
checksums/.verify/

# ---- salmon 定量中间/产物（可重跑生成）----
results/quantification/**/intermediate_mappings*
results/quantification/**/aux_info/
results/quantification/**/*.rad
results/quantification/**/logs/

# ---- 第三方 QC 产物（可重建；其 HTML/JSON 内嵌完整命令行与绝对路径）----
results/qc/multiqc_report.html
results/qc/multiqc_report_data/
results/qc/fastp/*.html
results/qc/fastqc/
*.parquet

# ---- Quarto 构建缓存（typst 包等，自动重建）----
**/.quarto/

# ---- 报告目录内的图件副本（由 20_render_report.sh 复制）----
docs/report/figures/

# ---- bowtie2 索引（由脚本重建）----
refs/diagnostic/*.bt2
refs/diagnostic/*.rev.*
refs/index/**
!refs/index/.gitkeep

# ---- 注释映射中间产物（由 scripts/05_enrichment/16a_build_term2gene.R 重建）----
refs/host/annotation/term2gene_go_propagated.tsv

# ---- 可由脚本确定性重建的大文件（md5 记录在 refs/VERSIONS.md）----
refs/custom/gentrome.fa
refs/custom/transcripts.fa
refs/host/host_transcripts_gffread.fa

# ---- 裁决实验中间产物（可重跑生成）----
refs/custom/adjudication/subsample/
refs/custom/adjudication/*.bam
refs/custom/adjudication/*.bam.bai
refs/custom/adjudication/*.bt2
refs/custom/adjudication/*.bt2l
*.fq.gz

# ---- 运行日志 ----
logs/*
!logs/.gitkeep

# ---- 环境与缓存 ----
renv/library/
.Rproj.user/
.Rhistory
.RData
.Ruserdata
__pycache__/
.ipynb_checkpoints/
.cache/
*.quarto_ipynb

# ---- 编辑器 / 系统 ----
.DS_Store
.vscode/
.idea/
*.swp

# ---- 凭据（绝不入库）----
.env
*.pem
*token*
!docs/decisions/token_notes.md

# ---- 临时文件 ----
.tmp_*
refs/host/.tmp_*
