# ---- 大文件：不入库，仅保留下载/构建脚本与校验值 ----
data/raw/fastq/*
!data/raw/fastq/.gitkeep
data/processed/fastq/*
!data/processed/fastq/.gitkeep
refs/index/
refs/host/*.fna.gz
refs/host/*.fa.gz
refs/host/*.gbff.gz
*.bam
*.bam.bai
*.bai
*.sra
*.fastq
*.fastq.gz

# ---- 运行日志 ----
logs/*
!logs/.gitkeep

